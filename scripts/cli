#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

build() {
    rm -rf _build
    ./node_modules/.bin/tsc
    cp metadata.json LICENSE _build/
    mkdir -p _build/schemas
    cp schemas/*.xml _build/schemas/
    glib-compile-schemas --strict _build/schemas
    bash scripts/compile-locales.sh
}

case "${1:-}" in
    build) build ;;
    pack) make release ;;
    clean) make clean ;;
    cleanup) echo 'Compiled schemas are retained in installable packages.' ;;
    install|inject) make install ;;
    translate)
        build
        bash scripts/update-pot.sh
        ;;
    dev)
        make install
        dbus-run-session gnome-shell --devkit --wayland --no-x11
        ;;
    dev:container)
        make install
        distrobox enter gnome-dev -- env PIPEWIRE_RUNTIME_DIR="/run/host/${XDG_RUNTIME_DIR#/}" PIPEWIRE_REMOTE=pipewire-0 G_MESSAGES_DEBUG=all dbus-run-session gnome-shell --devkit --wayland --no-x11
        ;;
    *) echo "Unknown command '${1:-}'" >&2; exit 2 ;;
esac
